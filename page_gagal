<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Galeri</title>
  <style>
    body { margin: 0; padding: 20px; background: #f8f8f8; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 15px;
    }
    img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
  </style>
</head>
<body>
  <div class="grid">
    <!-- Pakai URL absolut -->
    <img src="https://tekashe69.github.io/testing/page_gagal.html" alt="">

    <!-- Atau path relatif kalau gambar ada di repo yang sama -->
    <img src="./images/foto3.jpg" alt="">
    <img src="./images/foto4.webp" alt="">
  </div>
</body>
</html>
